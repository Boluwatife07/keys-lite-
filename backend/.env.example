# Copy to .env and fill in. Every service has a mock, so the API runs with none set.
PORT=3000
DATABASE_URL=postgres://keys@localhost:5432/keys
LINK_BASE_URL=https://keys.app
STORAGE_DIR=./storage
# 64 hex chars (32 bytes). Encrypts address-verification documents at rest.
DOCUMENT_KEY_HEX=

MOCK_EMAIL=true          # false -> send with Resend
RESEND_API_KEY=
EMAIL_FROM="Keys <hello@keys.app>"

MOCK_PLACES=true         # false -> Google Places (New) + Geocoding
GOOGLE_PLACES_KEY=

MOCK_STRIPE=true         # false -> Stripe zero-amount SetupIntent address check
STRIPE_SECRET_KEY=

MOCK_SOCIAL=true         # false -> verify Apple / Google identity tokens
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=

# Placeholders until Legal signs off (XFR-08.1)
TERMS_URL=https://keys.app/legal/terms
PRIVACY_URL=https://keys.app/legal/privacy
SAFETY_URL=https://keys.app/legal/safety
